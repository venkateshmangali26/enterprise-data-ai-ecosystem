# =============================================================================
# Tri-Pillar Enterprise Ecosystem - Environment Configuration
# =============================================================================

# --- Pillar 1: Retail Analytics (Bun + SQLite) ---
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./backend/retail_analytics.db
DB_PATH=./backend/retail_analytics.db
NODE_ENV=production

# --- Pillar 2: AutoRAG Telemetry Engine (FastAPI) ---
RAG_PORT=8000
RAG_HOST=0.0.0.0

# LLM Providers (Optional - Engine defaults to extractive grounded fallback if omitted)
# Option A: OpenAI API
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Option B: Google Gemini API (via official OpenAI-compatible endpoint)
GEMINI_API_KEY=
# LLM_MODEL=gemini-1.5-flash

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

